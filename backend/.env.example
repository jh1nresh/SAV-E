# Savvy backend environment variables (names only — set real values in Railway).

# --- Postgres ---
# Railway provides DATABASE_URL. Do not commit real credentials.
DATABASE_URL=
DATABASE_CA_CERT=
# libpq / psql accept: disable, allow, prefer, require, verify-ca, verify-full.
# Prefer require for applies. Modern libpq rejects no-verify.
# If a URL still carries sslmode=no-verify, strip the query string and override
# for that psql only (does not rewrite the Railway service variable):
#   PGSSLMODE=require psql "${DATABASE_URL%%\?*}" -v ON_ERROR_STOP=1 -1 -f …
# Node pg still recognizes no-verify so an already-set Railway service var
# keeps working; do not change a live service PGSSLMODE from a docs PR.
PGSSLMODE=require

# --- Authenticated account-reference verification ---
SAVE_ACCOUNT_REF_SECRET=
# Comma-separated retained secrets for verified reference rotation.
SAVE_ACCOUNT_REF_PREVIOUS_SECRETS=
# Existing signed "my Savvy" secret; also recognized as the legacy account-ref
# secret when SAVE_ACCOUNT_REF_SECRET replaced the original fallback.
SAVE_MY_SAVES_SECRET=

# --- Sendblue iMessage bot (spike) ---
# POST /v0/sendblue/webhook fetches a texted link's caption, extracts the venue
# via Gemini, and replies via the Sendblue API.
SENDBLUE_API_KEY_ID=
SENDBLUE_FROM_NUMBER=
SENDBLUE_API_SECRET=
# Optional: if set, inbound webhooks are HMAC-verified. Skip for the spike.
SENDBLUE_SIGNING_SECRET=

# --- Gemini (venue extraction; already used elsewhere in the backend) ---
GEMINI_API_KEY=
# Or, alternatively:
GOOGLE_GEMINI_API_KEY=
# Optional model override:
SAVE_MAAT_GEMINI_MODEL=

# --- Authenticated China place resolution (server-side only) ---
# Reuses the Web Service key name from R8. Activate only after provider usage
# authorization is confirmed. International WGS84 access requires separate
# Amap overseas permission for the same Web Service key.
AMAP_WEB_SERVICE_KEY=
AMAP_INTERNATIONAL_WEB_SERVICE_KEY=
AMAP_USAGE_AUTHORIZED=false
