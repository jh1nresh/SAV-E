      }
    },
    "clip.error.server.title" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Savvy is busy right now" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "Savvy 暫時忙不過來" } }
      }
    },
    "clip.error.server.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Wait a moment and try again." } },
