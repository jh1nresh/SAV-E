      }
    },
    "clip.listPartial.body" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The free plan saves up to 50 unique places, in list order. %d could not be added. Manage your saved places in Savvy, then try again." } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "免費版最多收藏 50 個不重複地點，依清單順序儲存。還有 %d 家未加入；到 Savvy 整理收藏後，再試一次。" } }
      }
    },
    "clip.openMaps" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in Apple Maps" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在 Apple 地圖開啟" } }
