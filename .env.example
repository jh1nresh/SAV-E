# SAV-E iOS - Environment Variables
# Copy this file to .env and fill in your values

# Gemini API (server-side only; iOS uses the backend proxy)
GEMINI_API_KEY=YOUR_BACKEND_GEMINI_KEY
# Model allowlist for the proxy. Defaults to gemini-3.5-flash alone, so every
# model in SAVEProductionConfig.defaultGeminiModelFallbacks must be listed here
# or the app's fallback leg answers 400.
SAVE_GEMINI_PROXY_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Google Places API (for place matching & details)
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_KEY

# Mobile backend
SAVE_API_URL=https://your-save-api.up.railway.app
# Legacy fallback for older local/TestFlight configs. Prefer SAVE_API_URL for new setup.
WANDERLY_API_URL=https://your-save-api.up.railway.app

# Public share links / App Clip domain
SAVE_SHARE_BASE_URL=https://wanderly.app/trip
# Legacy fallback for older configs. Prefer SAVE_SHARE_BASE_URL for new setup.
WANDERLY_SHARE_BASE_URL=https://wanderly.app/trip

# Railway backend secrets (server-side only; never ship in app)
DATABASE_URL=postgresql://postgres:password@host:port/railway
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----..."
# Both fall back to a random per-process value, which drops guest sessions and
# /my/<token> links on every restart or deploy. Set them in production.
SAVE_GUEST_SESSION_SECRET=YOUR_STABLE_RANDOM_SECRET
SAVE_MY_SAVES_SECRET=YOUR_STABLE_RANDOM_SECRET

# Amap (server-side only). POST /place-resolve needs the opt-in plus at least one
# key; without them it answers 503 and China places resolve through Apple Maps.
AMAP_USAGE_AUTHORIZED=false
AMAP_INTERNATIONAL_WEB_SERVICE_KEY=YOUR_AMAP_INTERNATIONAL_KEY
AMAP_WEB_SERVICE_KEY=YOUR_AMAP_DOMESTIC_KEY

# Privy (authentication)
PRIVY_APP_ID=clxxxxx
PRIVY_APP_CLIENT_ID=clxxxxx

# Expo / RN Web public env
EXPO_PUBLIC_SAVE_API_URL=https://your-save-api.up.railway.app
EXPO_PUBLIC_WANDERLY_API_URL=https://your-save-api.up.railway.app
EXPO_PUBLIC_SAVE_SHARE_BASE_URL=https://wanderly.app/trip
EXPO_PUBLIC_WANDERLY_SHARE_BASE_URL=https://wanderly.app/trip
EXPO_PUBLIC_PRIVY_APP_ID=clxxxxx
EXPO_PUBLIC_PRIVY_APP_CLIENT_ID=clxxxxx
